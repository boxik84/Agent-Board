DATABASE_URL=postgresql://agentboard:agentboard@localhost:5432/agentboard

JWT_SECRET=change-me-in-production-use-32-chars-min

# OpenClaw integration
# Set to "mock" for local dev without real OpenClaw
# Set to "http://localhost:18789" on VPS with real OpenClaw
OPENCLAW_HOST=mock
OPENCLAW_TOKEN=your-openclaw-bearer-token

# Callback URL that OpenClaw will POST results to
# For local dev: use ngrok or keep mock mode
CALLBACK_BASE_URL=http://localhost:3001

PORT=3001
